# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Optional: register slash commands in one server only (instant, handy while testing)
GUILD_ID=
# 1 = read the codes channel set with /setup (needs the Message Content intent in the developer portal)
ENABLE_CODE_WATCH=1
# Minutes between automatic runs over all accounts and active codes (minimum 10)
AUTO_INTERVAL_MIN=60
# Accounts per Discord user
MAX_ACCOUNTS=10
# Pause between calls to the Dark War Gift Center, in ms
DWS_DELAY_MS=2500
# Where linked accounts and codes are stored
DATA_FILE=data/db.json
